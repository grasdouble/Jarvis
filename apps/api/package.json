{
  "name": "@jarvis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @jarvis/domain run build && tsc",
    "typecheck": "pnpm --filter @jarvis/domain run build && tsc --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "dependencies": { "@jarvis/contracts": "workspace:*", "@jarvis/domain": "workspace:*" }
}
